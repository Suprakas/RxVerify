# --- Server ---
NODE_ENV=development
PORT=5000
# Proxies in front of the API: 1 locally / Render alone, 2 behind the Netlify proxy + Render
TRUST_PROXY=1
# Comma-separated list of allowed frontend origins (CORS + Socket.io)
CLIENT_ORIGIN=http://localhost:5173

# --- Database ---
MONGO_URI=mongodb+srv://suprakashballav1997_db_user:aRfobh0WhywsJzlJ@rxverify0.ejocx1h.mongodb.net/rxverify?retryWrites=true&w=majority&appName=RxVerify0
#RxVerify0 cluster credentials
user name = suprakashballav1997_db_user
