# --- Auth (use long random strings in production) ---
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7
# true when served over HTTPS
COOKIE_SECURE=false

# --- Review locks ---
LOCK_MINUTES=10
LOCK_SWEEP_SECONDS=60

# --- File storage: local | cloudinary ---
MAX_UPLOAD_MB=5
STORAGE_DRIVER=local
# UPLOAD_DIR=./uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=rxverify

# --- Optional AI medicine extraction (sends prescription files to OpenAI) ---
AI_EXTRACTION_ENABLED=false
OPENAI_API_KEY=
# Any vision-capable model available on your OpenAI account
OPENAI_MODEL=gpt-4.1-mini
